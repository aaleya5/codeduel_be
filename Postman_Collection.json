          {
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Challenge Invitations and Requests",
          "item": [
            {
              "name": "Preview Invitation",
              "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/api/challenges/invite/{{invite_code}}" }
              },
              "response": []
            },
            {
              "name": "Request to Join from Invitation",
              "request": {
                "method": "POST",
                "header": [],
                "url": { "raw": "{{base_url}}/api/challenges/invite/{{invite_code}}/request" }
              },
              "response": []
            },
            {
              "name": "List Pending Join Requests (Owner)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const requests = pm.response.json().data || [];",
                      "  if (requests.length) pm.collectionVariables.set('join_request_id', requests[0].id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}/join-requests" }
              },
              "response": []
            },
            {
              "name": "Approve Join Request (Owner)",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"decision\": \"APPROVED\"\n}" },
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}/join-requests/{{join_request_id}}" }
              },
              "response": []
            },
            {
              "name": "Reject Join Request (Owner)",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"decision\": \"REJECTED\"\n}" },
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}/join-requests/{{join_request_id}}" }
              },
              "response": []
            },
            {
              "name": "Update Challenge Rules (Owner)",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated challenge name\",\n  \"minSubmissionsPerDay\": 2,\n  \"endDate\": \"2027-12-31T23:59:59.999Z\"\n}" },
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}" }
              },
              "response": []
            },
            {
              "name": "Remove Challenge Member (Owner)",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}/members/{{member_id}}" }
              },
              "response": []
            },
            {
              "name": "Adjust Member Penalty (Owner)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{\n  \"amount\": 5,\n  \"reason\": \"Manual adjustment for testing\"\n}" },
                "url": { "raw": "{{base_url}}/api/challenges/{{challenge_id}}/members/{{member_id}}/penalty-adjustment" }
              },
              "response": []
            },
            {
              "name": "List Pending Penalty Disputes (Owner)",
              "request": {
                "method": "GET",
                "header": [],
