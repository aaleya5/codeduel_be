              "mode": "raw",
              "raw": "{\n  \"name\": \"January 2027 Daily Challenge\",\n  \"description\": \"Solve at least 1 Medium or Hard problem daily\",\n  \"minSubmissionsPerDay\": 1,\n  \"difficultyFilter\": [\"Medium\", \"Hard\"],\n  \"uniqueProblemConstraint\": true,\n  \"penaltyAmount\": 100,\n  \"startDate\": \"2027-01-07T00:00:00.000Z\",\n  \"endDate\": \"2027-01-31T23:59:59.999Z\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/challenges",
              "host": ["{{base_url}}"],
              "path": ["api", "challenges"]
            }
          },
          "response": []
