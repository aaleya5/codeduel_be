# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/leetcode_tracker"

# JWT Configuration
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Encryption Configuration
# Generate a strong random key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_encryption_key_here_change_this_in_production

# LeetCode API Configuration
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql

# Cron Configuration
CRON_ENABLED=true
# Cron expression for daily evaluation (default: 1 AM daily)
# Format: minute hour day month weekday
# Examples:
#   0 1 * * * = Every day at 1:00 AM
#   0 0 * * * = Every day at midnight
#   */15 * * * * = Every 15 minutes (for testing)
DAILY_EVALUATION_TIME=0 1 * * *

# Time zone used for challenge-day boundaries, evaluations, and streaks
CHALLENGE_TIME_ZONE=Asia/Kolkata

# CORS Configuration
# Comma-separated exact origins. For production replace this with the deployed
# frontend origin(s), e.g. https://app.example.com,https://staging.example.com
CORS_ORIGINS=http://localhost:8080

# Razorpay webhook secret configured in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret
